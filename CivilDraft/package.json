{
  "name": "civildraft",
  "version": "1.1.0",
  "description": "CivilDraft — مرسمة مخطّطات معمارية عربية تعمل في المتصفّح بلا اعتماديات",
  "main": "desktop/main.cjs",
  "author": "CivilDraft",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node js/tests/all.js",
    "test:geom": "node js/tests/geom.js",
    "test:core": "node js/tests/core.js",
    "test:inspect": "node js/tests/inspect.js",
    "test:tools": "node js/tests/tools.js",
    "test:ui": "node js/tests/ui.js",
    "test:run": "node js/tests/run.js",
    "test:trace": "node js/tests/trace.js",
    "test:store": "node js/tests/store.js",
    "test:dxf": "node js/tests/dxfin.js",
    "test:perf": "node js/tests/perf.js",
    "test:perfbudget": "node js/tests/perf.budget.test.js",
    "test:geomprop": "node js/tests/geom.property.test.js",
    "test:exportflow": "node js/tests/export-flow.test.js",
    "test:progress": "node js/tests/progress.test.js",
    "test:dom": "node js/tests/dom.js",
    "test:boq": "node js/tests/boq.test.js",
    "test:elev": "node js/tests/elevation.test.js",
    "test:sect": "node js/tests/section.test.js",
    "test:blocks": "node js/tests/blocks.js",
    "test:pricing": "node js/tests/pricing.js",
    "test:templates": "node js/tests/templates.js",
    "test:golden": "node js/tests/golden.js",
    "golden:update": "node js/tests/golden.js --update",
    "test:all": "node js/tests/all.js",
    "test:help": "node js/tests/help.test.js",
    "test:smartblocks": "node js/tests/smartblocks.test.js",
    "test:newfeat": "node js/tests/newfeat.test.js",
    "test:migrate": "node js/tests/migrate.test.js",
    "test:underlay": "node js/tests/underlay.test.js",
    "test:pricingpanel": "node js/tests/pricingPanel.test.js",
    "test:bootsplash": "node js/tests/bootsplash.test.js && node js/tests/dxfarc.test.js && node js/tests/csp.test.js",
    "test:code": "node js/tests/code.test.js && node js/tests/index.test.js",
    "test:journal": "node js/tests/journal.test.js",
    "test:c2": "node js/tests/phaseC2-macro.test.js",
    "test:ribbon": "node js/tests/ribbon.test.js && node js/tests/ribbon-editor.test.js && node js/tests/ribbon-overflow.test.js",
    "test:review": "node js/tests/review.test.js",
    "test:limits": "node js/tests/limits.test.js",
    "test:parse": "node js/tests/parse.test.js",
    "test:coords": "node js/tests/coords.test.js",
    "test:mharden": "node js/tests/mharden.test.js",
    "test:validate": "node js/tests/validate.test.js",
    "test:shape": "node js/tests/shape.test.js",
    "test:blocks-fromjson": "node js/tests/blocks-fromjson.test.js",
    "test:underlay-image": "node js/tests/underlay-image.test.js",
    "test:project": "node js/tests/project.test.js",
    "test:red": "node js/tests/red/defects.red.js",
    "test:txn": "node js/tests/transaction.test.js",
    "test:toolhist": "node js/tests/tools-history.test.js",
    "test:fixed": "node js/tests/fixed-defects.test.js",
    "test:stairs-lu": "node js/tests/stairs-lu.test.js",
    "test:roof": "node js/tests/roof.test.js",
    "test:harness": "node js/tests/harness.test.js",
    "test:phase8": "node js/tests/phase8.gate.test.js",
    "test:phase10": "node js/tests/phase10.gate.test.js",
    "test:phase11": "node js/tests/phase11.fixes.test.js",
    "test:updater": "node js/tests/updater.test.js",
    "test:release": "node js/tests/release.test.js",
    "test:e2e": "playwright test -c desktop/e2e",
    "test:e2e:headed": "playwright test -c desktop/e2e --headed",
    "cover": "node js/tests/cover.js",
    "cover:list": "node js/tests/cover.js --list",
    "serve": "node serving/static-server.js",
    "icons": "node scripts/gen-icons.js",
    "icons:file": "node scripts/gen-file-icon.js",
    "sw:core": "node scripts/gen-sw-core.js",
    "sw:check": "node scripts/gen-sw-core.js --check",
    "build": "node scripts/gen-sw-core.js --check && node scripts/build-dist.js",
    "build:bundle": "node scripts/build-dist.js --bundle",
    "test:deploy": "node js/tests/deploy.test.js",
    "check:syntax": "node js/tests/phase0-check.test.js",
    "check:imports": "node js/tests/phase0-guards.test.js",
    "check": "node --check js/app.js && node js/tests/phase0-check.test.js && node js/tests/dom.js && node js/tests/geom.js && node js/tests/core.js",
    "cf:deploy": "npm run build && npx wrangler pages deploy dist --project-name=civildraft",
    "cf:dev": "npm run build && npx wrangler pages dev dist",
    "test:cloudflare": "node js/tests/cloudflare.test.js",
    "desktop": "electron .",
    "desktop:build": "node scripts/build-dist.js && electron .",
    "dist:win": "node scripts/build-dist.js && electron-builder --win",
    "dist:portable": "node scripts/build-dist.js && electron-builder --win portable",
    "dist:win:arm": "node scripts/build-dist.js && node scripts/dist-win-arm.js",
    "release:info": "node scripts/release-info.js",
    "check:desktop": "node --check desktop/main.cjs && node --check desktop/preload.cjs && node --check scripts/after-pack.cjs && node --check scripts/dist-win-arm.js && node --check scripts/release-info.js && node --check desktop/updater.cjs"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "keywords": [
    "architecture",
    "cad",
    "dxf",
    "arabic",
    "rtl",
    "canvas"
  ]
}
